<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GPT 娘 · 聊天" Width="390" Height="550" ShowActivated="False"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#66507E"/>
      <Setter Property="Background" Value="#F0EAF8"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="#E8DDF5"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="Background" Value="#E8DDF5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid>
  <Border x:Name="ChatExpanded" Background="#FFFCFF" BorderBrush="#D8C8E9" BorderThickness="1" CornerRadius="16" Padding="17">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid>
        <StackPanel><TextBlock Text="GPT 娘 · 聊天" FontSize="19" FontWeight="SemiBold" Foreground="#57416E"/>
          <TextBlock x:Name="ChatGreeting" Text="老大，随时喊我" FontSize="11" Foreground="#9786A5" Margin="0,4,34,0" TextWrapping="Wrap"/></StackPanel>
        <Button x:Name="CloseChatPanel" Content="×" FontSize="20" Width="30" Height="30" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="收起聊天面板"/>
      </Grid>
      <TextBox x:Name="ChatPrompt" Grid.Row="1" Height="77" Margin="0,17,0,8" Padding="10,8" FontSize="13"
               TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MaxLength="2000"
               Background="White" BorderBrush="#DACEE9" BorderThickness="1" Foreground="#4E3C61"
               AutomationProperties.Name="输入新聊天内容" ToolTip="Enter 打开 Codex；Shift+Enter 换行"/>
      <Grid Grid.Row="2">
        <TextBlock Text="Enter 继续 · Shift+Enter 换行" FontSize="10.5" Foreground="#9786A5" VerticalAlignment="Center"/>
        <Button x:Name="ContinueChat" Content="在 Codex 中继续 →" FontSize="12" HorizontalAlignment="Right" ToolTip="打开新聊天并填入内容，随后在 Codex 中发送"/>
      </Grid>
      <TextBlock x:Name="ChatFeedback" Grid.Row="3" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#A85848"/>
      <Grid Grid.Row="4" Margin="0,18,0,9">
        <TextBlock Text="本机聊天" FontSize="13" FontWeight="SemiBold" Foreground="#66507E"/>
        <TextBlock x:Name="ChatSummary" HorizontalAlignment="Right" FontSize="11" Foreground="#9786A5"/>
      </Grid>
      <ScrollViewer x:Name="ChatScroll" Grid.Row="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ChatList"/>
      </ScrollViewer>
      <TextBlock x:Name="ChatFooter" Grid.Row="6" Text="正在读取聊天…" FontSize="10.5" TextWrapping="Wrap" Foreground="#9786A5" Margin="0,12,0,0"/>
    </Grid>
  </Border>
  <Button x:Name="ChatStatus" Visibility="Collapsed" Focusable="False" Padding="12,7" Background="#F4F0FA" ToolTip="点击展开聊天">
    <TextBlock x:Name="ChatStatusText" Text="老大，我正在忙" FontSize="12" Foreground="#6D9277" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
  </Button>
  <Button x:Name="ChatCompact" Visibility="Collapsed" Focusable="False" Padding="0" Background="#F4F0FA" ToolTip="点击展开聊天">
    <Viewbox MaxWidth="58" MaxHeight="26" Stretch="Uniform" StretchDirection="DownOnly">
    <Canvas Width="58" Height="26" IsHitTestVisible="False">
      <Ellipse x:Name="ChatDot1" Canvas.Left="9" Canvas.Top="10" Width="7" Height="7" Fill="#9B86C1"><Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform></Ellipse>
      <Ellipse x:Name="ChatDot2" Canvas.Left="25" Canvas.Top="10" Width="7" Height="7" Fill="#9B86C1"><Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform></Ellipse>
      <Ellipse x:Name="ChatDot3" Canvas.Left="41" Canvas.Top="10" Width="7" Height="7" Fill="#9B86C1"><Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform></Ellipse>
    </Canvas>
    </Viewbox>
  </Button>
  </Grid>
</Window>
